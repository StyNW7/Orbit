{
  "name": "@orbit/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared Orbit domain constants, types and pure helpers used by web and api.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --silent",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --silent",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@orbit/config": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "~5.7.3"
  }
}
