{
  "name": "@orbit/api",
  "version": "1.0.0",
  "private": true,
  "description": "Orbit API â€” NestJS + Prisma + PostgreSQL (Supabase) + Langflow gateway",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.ts\" \"prisma/**/*.ts\"",
    "test": "jest",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:seed": "dotenv -e ../../.env -- ts-node --transpile-only prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/throttler": "^6.4.0",
    "@orbit/shared": "workspace:*",
    "@prisma/client": "^6.4.1",
    "@supabase/supabase-js": "^2.48.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cron": "3.5.0",
    "date-fns": "^4.1.0",
    "fast-xml-parser": "^4.5.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@nestjs/cli": "^11.0.4",
    "@nestjs/testing": "^11.0.10",
    "@orbit/config": "workspace:*",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.4",
    "@types/pdf-parse": "^1.1.4",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "prisma": "^6.4.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.24.1"
  }
}
