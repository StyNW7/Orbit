# =============================================================
# Orbit environment variables
# Copy to `.env` at the repository root:  cp .env.example .env
# Server-only values must NEVER be prefixed with VITE_.
# =============================================================

# ---------- API server ----------
NODE_ENV=development
API_PORT=4000
FRONTEND_URL=http://localhost:5173

# ---------- Database (Supabase PostgreSQL or local docker) ----------
# Local docker (pnpm infra:up):
DATABASE_URL=postgresql://orbit:orbit@127.0.0.1:54322/orbit?schema=public&connect_timeout=30
DIRECT_URL=postgresql://orbit:orbit@127.0.0.1:54322/orbit?schema=public&connect_timeout=30
# Supabase (Project Settings -> Database -> Connection string):
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------- Authentication ----------
# When SUPABASE_URL is set, Orbit uses Supabase Auth (JWT verified by NestJS).
# When it is empty, Orbit falls back to built-in email/password auth signed with APP_JWT_SECRET.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=orbit-files
APP_JWT_SECRET=change-me-to-a-long-random-string

# ---------- Langflow (Orbit Career Agent orchestration) ----------
LANGFLOW_BASE_URL=http://localhost:7861
LANGFLOW_FLOW_ID=
LANGFLOW_API_KEY=
# Model the Langflow flow runs on: ollama | groq | watsonx (set by `pnpm langflow:setup -- --write-env`).
# With ollama on a CPU-only machine Orbit skips Langflow automatically (too slow for live answers).
LANGFLOW_MODEL_PROVIDER=ollama
LANGFLOW_TIMEOUT_MS=90000
# Shared secret Langflow tool components send back to /api/agent/tools/*
ORBIT_TOOL_API_KEY=change-me-orbit-tool-key
# How Langflow (inside docker) reaches the API on your host
ORBIT_API_URL_FOR_LANGFLOW=http://host.docker.internal:4000/api

# ---------- AI provider (used for CV extraction, explanations, direct agent fallback) ----------
# ollama | groq | watsonx | none
AI_PROVIDER=ollama
AI_MODEL=granite3.3:2b
AI_TIMEOUT_MS=60000
# Agent answer budget; slower models fall back to Orbit's deterministic planner
AGENT_TIMEOUT_MS=35000
# auto | on | off  (auto = native tool calling for groq/watsonx, grounded generation for local Ollama)
AGENT_TOOL_CALLING=auto
OLLAMA_BASE_URL=http://localhost:11434
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct

# ---------- Embeddings (pgvector) ----------
# local = deterministic hashing embeddings (no model needed) | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text

# ---------- External opportunity & knowledge providers ----------
# When false, Orbit uses curated seed data only (safe for offline demos).
ENABLE_EXTERNAL_PROVIDERS=true
GOOGLE_BOOKS_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_EMAIL=

# ---------- Readiness engine (optional weight override, must sum to 1) ----------
# READINESS_WEIGHTS={"skill":0.30,"experience":0.25,"portfolio":0.15,"knowledge":0.10,"application":0.10,"interview":0.10}

# ---------- Scheduler ----------
NOTIFICATION_CRON=*/5 * * * *

# ---------- Web (exposed to the browser — public values only) ----------
VITE_API_URL=http://localhost:4000/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
